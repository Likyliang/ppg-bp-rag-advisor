APP_ENV=development
REPORT_MODE=template_only
LLM_PROVIDER=mock
LLM_API_KEY=

# Report-generation LLM used by the Streamlit demo.
# Set LLM_PROVIDER to one of: mock | deepseek | anthropic (alias: claude).
# The same provider also powers advisor conversation replies
# (POST /api/v1/advisor/sessions/{id}/messages); with mock the advisor
# falls back to curated template replies and stays fully offline.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SEC=30

# Claude (Anthropic) report generation — the "Claude 出品" RAG report path.
# With LLM_PROVIDER=anthropic and REPORT_MODE=llm_rag, the report body is
# rewritten by Claude under the safety constraints and cites retrieved
# evidence inline as [n]; the numbered 参考文献 block is appended by the system.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=2400
ANTHROPIC_TEMPERATURE=0.4

# External embedding experiment: use the official OpenAI API key only for
# vectorizing governed chunks. Keep this separate from report generation keys.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_INPUT_SCOPE=processed_chunks
# With the key set and the index built (scripts/ingest_openai_embeddings.py),
# report/advisor retrieval automatically switches its vector backend to these
# OpenAI embeddings (settings.yaml retrieval.embedding_backend: auto).

# Evaluation/judge LLM: OpenAI-compatible third-party endpoint for offline
# evaluation only. Do not use it for embeddings or the user-facing demo.
EVAL_LLM_PROVIDER=openai_compatible
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
EVAL_LLM_MODEL=gpt-5.5
EVAL_LLM_TIMEOUT_SEC=60
EVAL_LLM_MAX_CONCURRENCY=2
EVAL_LLM_TEMPERATURE=0
EVAL_LLM_MAX_TOKENS=1200
EVAL_LLM_SEND_FULLTEXT=false
# Global rate limit for the relevance/faithfulness judge: minimum seconds
# between request STARTS, shared across all judge workers. Protects a small /
# personal GPT-5.5 endpoint from bursts. Default 1.5s (~40 req/min); 0 disables.
EVAL_LLM_MIN_INTERVAL_SEC=1.5

# Legacy/local vector options kept for the existing Chroma path.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_STORE=chroma
GUIDELINE_REGION=CN
RETRIEVAL_TOP_K=5

# ---------------------------------------------------------------------------
# Chapter-6 experiment switches (ablation harness only — leave UNSET for
# production / the quality gate). See paper-prep/110_*.md.
# ---------------------------------------------------------------------------
# RETRIEVAL_EMBEDDING_BACKEND : auto|openai|hashing|off — pin the vector backend
#   (the gate pins =hashing for offline determinism).
# RETRIEVAL_PER_SOURCE_CAP    : int — per-source dedup cap; 0 disables dedup (E1).
# RETRIEVAL_DISABLE_QUERY_CACHE : 1 — disable query-embedding cache so retrieval
#   variants don't share cached vectors (E1 fairness).
# REPORT_ENFORCE_CITATIONS    : 0 — bypass inline-citation forcing to build the
#   S3 (citation-enforcement OFF) generation variant (E2).
