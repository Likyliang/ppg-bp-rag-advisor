APP_ENV=development
REPORT_MODE=template_only
LLM_PROVIDER=mock
LLM_API_KEY=

# Report-generation LLM used by the Streamlit demo.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SEC=30

# External embedding experiment: use the official OpenAI API key only for
# vectorizing governed chunks. Keep this separate from report generation keys.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_INPUT_SCOPE=processed_chunks

# Evaluation/judge LLM: OpenAI-compatible third-party endpoint for offline
# evaluation only. Do not use it for embeddings or the user-facing demo.
EVAL_LLM_PROVIDER=openai_compatible
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
EVAL_LLM_MODEL=gpt-5.5
EVAL_LLM_TIMEOUT_SEC=60
EVAL_LLM_MAX_CONCURRENCY=2
EVAL_LLM_TEMPERATURE=0
EVAL_LLM_MAX_TOKENS=1200
EVAL_LLM_SEND_FULLTEXT=false

# Legacy/local vector options kept for the existing Chroma path.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_STORE=chroma
GUIDELINE_REGION=CN
RETRIEVAL_TOP_K=5
